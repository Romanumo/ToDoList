@host = http://localhost:5065

### Get all
GET {{host}}/todos

### Get one
GET {{host}}/todos/1

### Create
POST {{host}}/todos
Content-Type: application/json

{
  "task": "Do the dishes"
}

### Update
PUT {{host}}/todos/2
Content-Type: application/json

{
  "task": "Sleep"
}

### Delete
DELETE {{host}}/todos/1